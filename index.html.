<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEX VPN</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: white;
  background: radial-gradient(circle at top, #39206b, #100b1d 65%);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24px;
}
.app {
  width: 100%;
  max-width: 440px;
  padding: 30px 22px;
  background: #191329;
  border: 1px solid #49316e;
  border-radius: 24px;
  text-align: center;
  box-shadow: 0 20px 60px #0006;
}
.logo {
  font-size: 36px;
  font-weight: 800;
  letter-spacing: 3px;
  color: #c5a4ff;
}
.subtitle { color: #b9afca; margin: 10px 0 28px; }
h2 { font-size: 19px; }
.servers { display: grid; gap: 10px; margin: 18px 0; }
.server {
  padding: 15px;
  border: 1px solid #493c60;
  border-radius: 13px;
  background: #241b35;
  color: white;
  text-align: left;
  font-size: 16px;
  cursor: pointer;
}
.server.active {
  border-color: #bb91ff;
  background: #392452;
}
.connect {
  width: 100%;
  padding: 16px;
  border: 0;
  border-radius: 13px;
  background: linear-gradient(90deg, #9655ff, #c071ff);
  color: white;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
}
#message { color: #d8c6f5; min-height: 40px; line-height: 1.5; }
footer { color: #9588aa; font-size: 12px; margin-top: 20px; }
</style>
</head>
<body>
<main class="app">
  <div class="logo">LEX VPN</div>
  <p class="subtitle">Твой интернет. Твои правила.</p>
  <h2>Выбери локацию</h2>
  <div class="servers">
    <button class="server active" data-country="Нидерланды">🇳🇱 Нидерланды</button>
    <button class="server" data-country="Германия">🇩🇪 Германия</button>
    <button class="server" data-country="США">🇺🇸 США</button>
  </div>
  <button class="connect" id="connect">Подключить LEX VPN</button>
  <p id="message">Выбрана локация: Нидерланды</p>
  <footer>LEX VPN · Веб-интерфейс</footer>
</main>
<script>
const servers = document.querySelectorAll(".server");
const message = document.getElementById("message");
let country = "Нидерланды";

servers.forEach(function(server) {
  server.addEventListener("click", function() {
    servers.forEach(function(item) {
      item.classList.remove("active");
    });
    server.classList.add("active");
    country = server.dataset.country;
    message.textContent = "Выбрана локация: " + country;
  });
});

document.getElementById("connect").addEventListener("click", function() {
  message.textContent = "Сервер " + country + " пока не настроен. Это пока интерфейс сайта, а не действующее VPN-соединение.";
});
</script>
</body>
</html>
