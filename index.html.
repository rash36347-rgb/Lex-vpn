<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090711">
<title>LEX VPN</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh; padding: 24px;
  display: flex; align-items: center; justify-content: center;
  background: radial-gradient(ellipse at top, #30134b, #090711 65%);
  color: white; font-family: Arial, sans-serif;
}
.app { width: 100%; max-width: 390px; text-align: center; }
.logo { font-size: 48px; font-weight: 900; letter-spacing: 7px; color: #c99cff; }
.sub { color: #a99ab9; font-size: 12px; letter-spacing: 4px; margin-top: 8px; }
.panel {
  margin-top: 32px; padding: 26px 20px;
  background: #15111f; border: 1px solid #49305d;
  border-radius: 24px; box-shadow: 0 15px 55px #0008;
}
.status { color: #c4b4d4; font-size: 14px; margin-bottom: 24px; }
.circle {
  width: 145px; height: 145px; margin: auto; border-radius: 50%;
  border: 2px solid #9855d2; background: #251533;
  display: grid; place-items: center; box-shadow: 0 0 35px #a64cff30;
}
button, select { font: inherit; }
button { cursor: pointer; color: white; }
#connect {
  width: 100%; margin-top: 25px; padding: 16px;
  border: 0; border-radius: 13px;
  background: linear-gradient(100deg, #7738bc, #aa60eb);
  font-weight: bold;
}
.server { margin-top: 20px; text-align: left; padding: 15px; background: #21192d; border-radius: 13px; }
select {
  display: block; width: 100%; margin-top: 10px; padding: 12px;
  border-radius: 9px; background: #100d17; color: white; border: 1px solid #49375d;
}
.note { margin-top: 20px; color: #a99ab9; font-size: 12px; line-height: 1.6; }
</style>
</head>
<body>
<main class="app">
  <div class="logo">LEX</div>
  <div class="sub">PRIVATE NETWORK</div>
  <section class="panel">
    <div class="status" id="status">● VPN не подключён</div>
    <div class="circle">
      <svg width="65" height="65" viewBox="0 0 24 24" fill="none" stroke="#d5b4ff" stroke-width="1.5">
        <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>
    <button id="connect" onclick="demo()">ПОДКЛЮЧИТЬСЯ</button>
    <div class="server">
      <strong>Выбор сервера</strong>
      <select id="server">
        <option>Автоматически</option>
        <option>Германия</option>
        <option>Нидерланды</option>
        <option>Финляндия</option>
      </select>
    </div>
    <div class="note">LEX VPN · Первая версия
Демонстрационный интерфейс. VPN-соединение пока не настроено.</div>
  </section>
</main>
<script>
function demo() {
  document.getElementById('status').textContent =
    'Демо-режим · VPN-сервер не подключён';
  document.getElementById('connect').textContent = 'ДЕМО-РЕЖИМ';
}
</script>
</body>
</html>
