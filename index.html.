  <script>
    const connect = document.getElementById("connect");
    const status = document.getElementById("status");
    const hint = document.getElementById("hint");
    const dot = document.getElementById("dot");
    const servers = document.querySelectorAll(".server");

    let selected = "Нидерланды";

    function selectServer(server) {
      servers.forEach(item => {
        const active = item === server;
        item.classList.toggle("selected", active);
        item.setAttribute("aria-pressed", String(active));
      });

      selected = server.dataset.server;
      status.textContent = "VPN не подключён";
      dot.style.background = "#8b7c9d";

      hint.textContent =
        "Выбрана локация: " + selected +
        ". Для подключения нужен настоящий VPN-сервер.";
    }

    servers.forEach(server => {
      server.addEventListener("click", () => {
        selectServer(server);
      });

      server.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectServer(server);
        }
      });
    });

    connect.addEventListener("click", () => {
      status.textContent = "Сервер не настроен";
      dot.style.background = "#f59e0b";

      hint.textContent =
        "Локация: " + selected +
        ". Это пока интерфейс сайта. Настоящее VPN-подключение ещё не настроено.";

      connect.textContent = "Сервер ещё не подключён";
    });
  </script>
